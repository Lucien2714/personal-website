# Keep the build context small and free of anything that would leak into the
# image or invalidate its cache unnecessarily.
node_modules
.next
.git
.github
coverage
docs
tests

.env
.env.*
!.env.example

# Generated by `prisma generate` inside the image. Excluding it keeps a
# developer machine from shipping its own copy, which would mask a missing
# generate step in the Dockerfile - as it did once.
src/generated

*.log
*.tsbuildinfo
.DS_Store
Thumbs.db

# Uploaded media belongs on the volume, not in the image.
public/uploads/*
!public/uploads/.gitkeep

docker/backups
