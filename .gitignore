# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
next-env.d.ts

# Production artefacts
build/
dist/

# Prisma client, regenerated by `prisma generate` during build and in CI.
# Committing it would mean reviewing thousands of generated lines per schema
# change, and would let a stale client survive a merge.
/src/generated/

# Runtime data (uploaded media lives on a Docker volume in production)
/public/uploads/*
!/public/uploads/.gitkeep

# Environment
.env
.env.local
.env.*.local
!.env.example

# Test / tooling output
coverage/
.vitest/
*.tsbuildinfo

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*
*.log
