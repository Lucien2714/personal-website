# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Postgres connection string used by both the app and the Prisma CLI.
# The local development stack in docker-compose.dev.yml matches these values.
DATABASE_URL="postgresql://website:website@localhost:5432/personal_website?schema=public"

# --- Site ------------------------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, the RSS feed,
# sitemap entries and absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentication --------------------------------------------------------
# HMAC key for signing admin session tokens. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# Lifetime of an admin session, in seconds. Default: 7 days.
AUTH_SESSION_TTL_SECONDS="604800"

# --- Seed account ----------------------------------------------------------
# Used only by `npm run db:seed` when no user exists yet.
SEED_ADMIN_EMAIL="lucien2714@gmail.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_NAME="Lucien Chen"

# --- Uploads ---------------------------------------------------------------
# Directory that stores uploaded media. In Docker this is a mounted volume.
UPLOAD_DIR="./public/uploads"

# Maximum accepted upload size in bytes. Default: 10 MiB.
UPLOAD_MAX_BYTES="10485760"

# --- Public API ------------------------------------------------------------
# Comma-separated list of origins allowed to call /api/v1 from a browser.
# Use "*" to allow any origin for the read-only endpoints.
API_CORS_ORIGINS="*"

# Requests per minute allowed per client for /api/v1. Default: 120.
API_RATE_LIMIT_PER_MINUTE="120"

# --- Docker deployment only ------------------------------------------------
# Read by docker/docker-compose.yml. Not used by the app itself.

# Domain Caddy should obtain a TLS certificate for.
SITE_DOMAIN="lucien2714.com"

# Container image to run. Built and pushed by
# .github/workflows/publish.yml; the server only pulls.
# Pin IMAGE_TAG to a commit SHA to roll back to a known-good build.
IMAGE_REPO="ghcr.io/lucien2714/personal-website"
IMAGE_TAG="latest"

# Postgres credentials for the containerised database. DATABASE_URL is
# rewritten from these inside the compose file.
POSTGRES_USER="website"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="personal_website"

# --- Reader sign-in (OAuth) -------------------------------------------------
# Both providers are optional: whichever has an id and secret set is offered on
# the sign-in page, and the rest of the site works with none configured.
#
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/github/callback
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""

# Gitee: https://gitee.com/oauth/applications -> 创建应用
#   回调地址: <NEXT_PUBLIC_SITE_URL>/api/auth/gitee/callback
OAUTH_GITEE_CLIENT_ID=""
OAUTH_GITEE_CLIENT_SECRET=""
